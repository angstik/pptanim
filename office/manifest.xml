<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Manifeste du complément PowerPoint (facultatif). Il pointe sur la page publiée par GitHub Pages ;
     si l'adresse du site change, remplacer partout https://angstik.github.io/pptanim. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>5dee3947-4399-4d60-a213-7f37ab59e242</Id>
  <Version>0.2.1.0</Version>
  <ProviderName>PPT Anim</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="PPT Anim"/>
  <Description DefaultValue="Anime un texte lettre par lettre avec des animations PowerPoint natives."/>
  <IconUrl DefaultValue="https://angstik.github.io/pptanim/icons/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://angstik.github.io/pptanim/icons/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/angstik/pptanim"/>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://angstik.github.io/pptanim/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
